{
  "name": "@hyperwatch/hyperwatch",
  "version": "5.6.0",
  "description": "Open Source HTTP Traffic Manager",
  "license": "Apache-2.0",
  "author": "François Hodierne <francois@hodierne.net>",
  "contributors": [
    "Benoît Fleury",
    "Jean Duthon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperwatch/hyperwatch.git"
  },
  "main": "hyperwatch.js",
  "bin": {
    "hyperwatch": "bin/hyperwatch"
  },
  "files": [
    "bin",
    "config",
    "docs",
    "scripts",
    "src",
    "start.js",
    "types"
  ],
  "scripts": {
    "depcheck": "depcheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepack": "npm run types",
    "prepare": "husky",
    "prettier": "prettier \"**/*.@(js|cjs|ts|cts|json|md|yml)\"",
    "prettier:check": "npm run prettier -- --list-different",
    "prettier:write": "npm run prettier -- --write",
    "start": "node start",
    "test": "mocha --recursive",
    "type:check": "tsc -p .",
    "types": "node -e \"require('fs').rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.types.json",
    "types:test": "node scripts/test-types.js"
  },
  "types": "types/hyperwatch.d.ts",
  "dependencies": {
    "@hyperwatch/useragent": "^4.1.0",
    "accept-language-parser": "^1.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.0",
    "country-code-emoji": "^2.3.0",
    "csv-stringify": "^6.8.3",
    "debug": "^4.4.3",
    "dnsbl": "^6.0.0",
    "express": "^5.2.1",
    "geoip-lite": "^2.0.3",
    "immutable": "^5.1.9",
    "ip-address": "^10.7.3",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "micro-strptime": "^1.0.0",
    "proxy-addr": "^2.0.7",
    "rc": "^1.2.8",
    "structured-headers": "2.1.1",
    "syslog-parse": "^2.0.0",
    "tail": "^2.2.6",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@types/express": "^5"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@eslint/js": "^10.0.1",
    "@types/accept-language-parser": "^1.5.8",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/rc": "^1.2.4",
    "@types/tail": "^2.2.3",
    "@types/ws": "^8.18.2",
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mocha": "^12.0.0",
    "prettier": "^3.9.6",
    "prettier-package-json": "^2.8.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "unrs-resolver": false
  },
  "depcheck": {
    "ignores": [
      "prettier-package-json",
      "@types/*"
    ],
    "ignorePatterns": [
      "test/types"
    ]
  },
  "lint-staged": {
    "*.{js,cjs,ts,cts,json,md,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "prettier-package-json --write"
    ]
  }
}
