  {
    "name": "github-ips",
    "about": "The ranges GitHub runs its own services from (web, API, webhooks, git, Pages, Packages, importers, Copilot), where github-camo, the image proxy behind README badges, comes from. The `actions` ranges are left out: Actions runners there run any GitHub user's workflows. https://docs.github.com/en/rest/meta/meta",
    "urls": ["https://api.github.com/meta"],
    "headers": {
      "accept": "application/vnd.github+json"
    },
    "format": "keys",
    "keys": [
      "hooks",
      "web",
      "api",
      "git",
      "pages",
      "packages",
      "importer",
      "github_enterprise_importer",
      "copilot"
    ]
  },
